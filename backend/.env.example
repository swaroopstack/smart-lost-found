# ==========================================================
#  Smart Lost & Found - Backend environment configuration
#  Copy this file to `.env` and edit the values.
# ==========================================================

# --- Application ---
APP_NAME="Smart Lost & Found API"
ENVIRONMENT=development
VERSION=1.0.0
API_V1_PREFIX=/api/v1

# --- Security ---
# MUST be changed in production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-a-random-production-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database ---
# SQLite (default, zero setup):
DATABASE_URL=sqlite:///./slf.db
# PostgreSQL (optional, requires docker/psql):
# DATABASE_URL=postgresql+psycopg://slf:slf@localhost:5432/slf

# --- File uploads ---
UPLOAD_DIR=./uploads
MEDIA_URL_PREFIX=/media
MAX_UPLOAD_MB=5
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# --- CORS (comma separated; add your frontend dev origin) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# --- Startup behaviour ---
# Create tables automatically on boot (set false if you use migrations)
AUTO_CREATE_TABLES=true
# Insert base catalog + demo accounts on boot when the DB is empty
AUTO_SEED_BASE=true
